{
  "name": "inboxfusion",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "chart.js": "^4.5.1",
    "htmx.org": "^2.0.10",
    "lucide": "^1.28.0",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "css:dev": "bunx @tailwindcss/cli -i ./static_src/mailfusion.css -o ./portal/static/css/app.css --watch",
    "css:build": "bunx @tailwindcss/cli -i ./static_src/mailfusion.css -o ./portal/static/css/app.css --minify",
    "js:dev": "bun build ./static_src/mailfusion.ts ./static_src/inbox.ts --outdir ./portal/static/js --watch",
    "js:build": "bun build ./static_src/mailfusion.ts ./static_src/inbox.ts --outdir ./portal/static/js --minify",
    "dev": "bun run css:dev & bun run js:dev",
    "watch": "bun run css:dev & bun run js:dev",
    "build": "bun run css:build && bun run js:build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
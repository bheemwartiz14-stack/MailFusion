# Portal - Django application environment variables (example / template)
# Copy this file to .env and fill in real values. Never commit .env.

# Security: generate one with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
SECRET_KEY=change-me

# Django debug flag (never True in production)
DEBUG=True

# Comma-separated list of allowed hostnames (e.g. localhost,127.0.0.1,example.com)
ALLOWED_HOSTS=*

# Django settings module used by manage.py / WSGI / ASGI
DJANGO_SETTINGS_MODULE=core.settings

# Sessions & auth
SESSION_COOKIE_AGE=1209600
SESSION_INACTIVITY_TIMEOUT=1800

# Security (flip to True behind HTTPS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# Email (password reset delivery; console backend prints to stdout)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Portal <no-reply@example.com>

# PostgreSQL (docker compose `postgres` service)
POSTGRES_DB=InboxFusion
POSTGRES_USER=InboxFusion
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# pgAdmin web UI (http://127.0.0.1:8001/)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Microsoft OAuth (register app at https://portal.azure.com/)
# - Supported account types: Accounts in any organizational directory and personal Microsoft accounts
# - Redirect URI: http://localhost:8000/accounts/callback/
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_TENANT_ID=common  # or your Azure AD tenant ID for single-tenant apps
MICROSOFT_REDIRECT_URI=http://localhost:8000/accounts/callback/
SCOPES=offline_access User.Read Mail.Read Mail.ReadBasic Mail.ReadWrite

# Redis (cache + task coordination)
REDIS_URL=redis://127.0.0.1:6379/0

# Background task cadence (used by `manage.py scheduled_tasks`)
SYNC_INTERVAL_SECONDS=300
TOKEN_REFRESH_INTERVAL_MINUTES=10
WEBHOOK_RENEW_INTERVAL_MINUTES=15
LOG_CLEANUP_INTERVAL_HOURS=24
HEALTH_CHECK_INTERVAL_MINUTES=5

# Microsoft Graph webhooks (set base URL when using Change Notifications)
SYNC_WEBHOOK_BASE_URL=
SYNC_WEBHOOK_EXPIRATION_DAYS=3

# Synchronization tuning
SYNC_LOG_RETENTION_DAYS=30
SYNC_MAX_ATTACHMENT_BYTES=26214400